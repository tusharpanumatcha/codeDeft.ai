{
  "name": "codedeft-vscode",
  "displayName": "codeDeft",
  "description": "Repository-aware code intelligence powered by a local codeDeft engine",
  "version": "1.0.0",
  "publisher": "codedeft-local",
  "icon": "media/icon.png",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codedeft.chat",
        "title": "codeDeft: Chat (Figma or Repository)"
      },
      {
        "command": "codedeft.ask",
        "title": "codeDeft: Ask Repository"
      },
      {
        "command": "codedeft.index",
        "title": "codeDeft: Index Repository"
      },
      {
        "command": "codedeft.dashboard",
        "title": "codeDeft: Open Dashboard"
      },
      {
        "command": "codedeft.figmaConnect",
        "title": "codeDeft: Connect to Figma (PAT)"
      },
      {
        "command": "codedeft.figmaRead",
        "title": "codeDeft: Read Figma Design"
      },
      {
        "command": "codedeft.figmaDisconnect",
        "title": "codeDeft: Disconnect Figma"
      },
      {
        "command": "codedeft.independent",
        "title": "codeDeft: Generate Independent Feature (Review First)"
      },
      {
        "command": "codedeft.reuseDiscover",
        "title": "codeDeft: Discover Reusable Code"
      },
      {
        "command": "codedeft.openProposal",
        "title": "codeDeft: Open Proposal by ID"
      },
      {
        "command": "codedeft.connectAi",
        "title": "codeDeft: Connect AI Assistants (Copilot, Claude, …)"
      }
    ],
    "configuration": {
      "title": "codeDeft",
      "properties": {
        "codedeft.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4317",
          "description": "Local codeDeft API URL"
        },
        "codedeft.apiToken": {
          "type": "string",
          "default": "",
          "description": "Optional local API token (must match CODEDEFT_TOKEN on the server)"
        },
        "codedeft.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Node.js executable used to run the codeDeft MCP server for Copilot and other assistants (22.13 or newer)."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "codedeft.context",
        "label": "codeDeft repository context"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "build": "npm run typecheck && npm run bundle"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.90.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.3",
    "zod": "^4.6.7"
  },
  "activationEvents": [
    "onUri"
  ]
}
