{
  "name": "codedeft-hybrid",
  "private": true,
  "version": "0.8.0-migration",
  "type": "module",
  "scripts": {
    "build": "npm run build:engine",
    "build:engine": "cd packages/engine && npm install && npm run build",
    "start": "node apps/server/dist/index.js",
    "test": "node --test tests/*.test.mjs",
    "test:all": "npm test && cd packages/engine && npm test",
    "build:server": "npm --prefix apps/server run build",
    "build:extension": "npm --prefix apps/vscode-extension run build",
    "build:dashboard": "npm --prefix apps/web-dashboard run build",
    "build:apps": "npm run build:server && npm run build:extension && npm run build:dashboard",
    "dev:dashboard": "npm --prefix apps/web-dashboard run dev"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}